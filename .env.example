# Salen de los outputs de `cdk deploy` en ticket-parsing-cloud (UserPoolId,
# UserPoolClientId, ApiUrl). Copiar a .env y completar con los valores reales
# — .env está gitignored porque cada entorno (local/staging/prod) apunta a un
# stack distinto, no porque estos valores sean secretos (el app client de
# Cognito no tiene client secret, está pensado para vivir en un navegador).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
VITE_API_BASE_URL=
VITE_AGENT_DOWNLOAD_URL=/downloads/InnoAppAgent-Setup.exe
VITE_AGENT_VERSION=0.3.1

# Basemap del mapa de agentes. Sin esto usa el basemap oscuro keyless de Esri.
# Para Stadia/CARTO/MapTiler: pegar acá la URL de tiles con la API key incluida
# (ej. https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=XXXX)
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap
