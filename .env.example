# Salen de los outputs de `cdk deploy` en ticket-parsing-cloud (UserPoolId,
# UserPoolClientId, ApiUrl). Copiar a .env y completar con los valores reales
# — .env está gitignored porque cada entorno (local/staging/prod) apunta a un
# stack distinto, no porque estos valores sean secretos (el app client de
# Cognito no tiene client secret, está pensado para vivir en un navegador).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
VITE_API_BASE_URL=
